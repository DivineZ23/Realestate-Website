{
  "AllowedHosts": "*",
  "App": { "FrontendUrl": "http://localhost:4200" },
  "MongoDb": { "ConnectionString": "mongodb://localhost:27017", "DatabaseName": "imperial_estates" },
  "Jwt": { "SigningKey": "development-only-replace-with-a-long-random-secret", "Issuer": "ImperialEstates", "Audience": "ImperialEstates.Web", "ExpirationMinutes": 480 },
  "Discord": { "ClientId": "", "ClientSecret": "", "RedirectUri": "http://localhost:5080/api/v1/auth/discord/callback" },
  "Storage": { "LocalRoot": "wwwroot/uploads", "PublicBaseUrl": "/uploads", "ZiplineBaseUrl": "", "ZiplineApiToken": "", "MaximumFileSize": 10485760 },
  "SeedData": { "Enabled": false },
  "Serilog": {
    "MinimumLevel": { "Default": "Information", "Override": { "Microsoft": "Warning", "Microsoft.Hosting.Lifetime": "Information" } },
    "Enrich": ["FromLogContext"]
  }
}
